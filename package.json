{
  "name": "sota-peak-finder",
  "version": "3.7.4",
  "type": "module",
  "description": "SOTA Peak Finder: Find nearby summits worldwide with GPS. 179,000+ SOTA summits with references, points, altitude, and distance. Fully offline PWA for activators.",
  "scripts": {
    "dev": "vite",
    "build": "bun run sync:wasm && tsc && vite build",
    "sync:wasm": "bun scripts/sync-sqlite-wasm.ts",
    "build:sota": "bun scripts/build-sota-database.mjs",
    "build:sitemaps": "bun scripts/generate-summit-sitemap.mjs",
    "build:all": "bun run build:sota && bun run build:sitemaps && bun run build",
    "setup": "bun scripts/setup-dev-database.ts",
    "preview": "vite preview",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "lint": "biome check --diagnostic-level=error .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "knip": "knip",
    "lighthouse": "NODE_OPTIONS='--no-deprecation' lhci autorun",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "latest",
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "autoprefixer": "^10.5.4",
    "clsx": "^2.1.1",
    "husky": "^9.1.7",
    "knip": "^6.32.2",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "^3.53.0-build1",
    "esbuild": "^0.28.2",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-helmet-async": "^3.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.2"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write"
    ]
  }
}
